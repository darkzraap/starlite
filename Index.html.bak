                ${r.mapsIn ? `<a href="${r.mapsIn}" target="_blank" class="px-1.5 py-0.5 bg-teal-50 text-teal-700 rounded border border-teal-200 text-[10.5px] font-semibold hover:bg-teal-600 hover:text-white"><i class="fa-solid fa-location-dot"></i> ${r.koordinatIn}</a>` : '-'}
                ${r.fotoIn ? `<a href="${r.fotoIn}" target="_blank" class="px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded border border-slate-200 text-[10.5px] font-semibold hover:bg-slate-800 hover:text-white"><i class="fa-regular fa-image"></i> Foto In</a>` : ''}
              </td>
              <td class="tiimi-td font-mono-code font-semibold text-slate-800">${r.jamOut || '--:--'}</td>
              <td class="tiimi-td">
                ${r.jamOut ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Completed</span>` : `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-600 border border-rose-200">Belum Clock-Out</span>`}
              </td>
              <td class="tiimi-td whitespace-nowrap space-x-1.5">
                ${r.mapsOut ? `<a href="${r.mapsOut}" target="_blank" class="px-1.5 py-0.5 bg-indigo-50 text-indigo-700 rounded border border-indigo-200 text-[10.5px] font-semibold hover:bg-indigo-600 hover:text-white"><i class="fa-solid fa-location-dot"></i> ${r.koordinatOut}</a>` : '-'}
                ${r.fotoOut ? `<a href="${r.fotoOut}" target="_blank" class="px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded border border-slate-200 text-[10.5px] font-semibold hover:bg-slate-800 hover:text-white"><i class="fa-regular fa-image"></i> Foto Out</a>` : ''}
              </td>
            </tr>
          `).join('');
                }
            }

            renderPaginationBar(tableKey, meta);
        }

        // ================= MODAL DETAIL PERSONEL (BACA SEMUA TANGGAL, JAM, MAPS & FOTO) =================
        function openUserDetailModal(username) {
            const uKey = String(username).toLowerCase();
            const userObj = (tableState.users.data || []).find(u => u.username.toLowerCase() === uKey);
            const userLogs = (tableState.allLogs.data || []).filter(l => l.username.toLowerCase() === uKey);

            document.getElementById('detailModalName').textContent = userObj ? userObj.nama : username;
            document.getElementById('detailModalBadge').textContent = userObj ? `${userObj.status} • ${userObj.role}` : 'Sales';
            document.getElementById('detailModalSub').textContent = userObj ? `Username: ${userObj.username} | Stasiun: ${userObj.stasiun} (${userObj.provinsi})` : username;

            const totalHadir = userLogs.length;
            const totalOnTime = userLogs.filter(l => l.statusIn === 'On Time').length;
            const totalLate = userLogs.filter(l => l.statusIn === 'Late').length;
            const totalOut = userLogs.filter(l => l.jamOut !== '').length;

            document.getElementById('detStatHadir').textContent = totalHadir;
            document.getElementById('detStatOnTime').textContent = totalOnTime;
            document.getElementById('detStatLate').textContent = totalLate;
            document.getElementById('detStatOut').textContent = totalOut;

            tableState.userDetail.data = userLogs;
            tableState.userDetail.filters = {};
            tableState.userDetail.page = 1;
            document.querySelectorAll('[id^="flt_userDetail_"]').forEach(el => { el.value = ''; });
            renderTable('userDetail');

            document.getElementById('userDetailModal').classList.remove('hidden');
            document.getElementById('userDetailModal').classList.add('flex');
        }

        function closeUserDetailModal() {
            document.getElementById('userDetailModal').classList.add('hidden');
            document.getElementById('userDetailModal').classList.remove('flex');
        }

        // ================= REKAP AKUMULASI PER RENTANG TANGGAL (POIN 7) =================
        function recalculateSummaryByDateRange() {
            const startStr = document.getElementById('sumStartDate').value;
            const endStr = document.getElementById('sumEndDate').value;

            // Hitung jumlah hari kalender pada rentang tersebut
            let totalDaysInRange = 1;
            if (startStr && endStr) {
                const d1 = new Date(startStr);
                const d2 = new Date(endStr);
                const diffMs = d2 - d1;
                totalDaysInRange = diffMs >= 0 ? Math.floor(diffMs / 86400000) + 1 : 1;
            } else {
                // Jika mode "Semua Tanggal", hitung jumlah tanggal unik yang ada di database
                const uniqueDates = new Set((tableState.allLogs.data || []).map(l => l.tanggal));
                totalDaysInRange = Math.max(1, uniqueDates.size);
            }

            const summaryMap = {};
            masterSalesOnly.forEach(s => {
                summaryMap[s.username.toLowerCase()] = {
                    id: s.id,
                    username: s.username,
                    nama: s.nama,
                    status: s.status,
                    provinsi: s.provinsi,
                    stasiun: s.stasiun,
                    totalHadir: 0,
                    totalOnTime: 0,
                    totalLate: 0,
                    totalBelumOut: 0,
                    totalLengkap: 0,
                    totalBelumIn: totalDaysInRange
                };
            });

            const attendedDatesPerUser = {};

            (tableState.allLogs.data || []).forEach(log => {
                if (startStr && log.tanggal < startStr) return;
                if (endStr && log.tanggal > endStr) return;

                const uKey = log.username.toLowerCase();
                if (!summaryMap[uKey]) return;

                summaryMap[uKey].totalHadir += 1;
                if (log.statusIn === 'Late') {
                    summaryMap[uKey].totalLate += 1;
                } else if (log.statusIn === 'On Time') {
                    summaryMap[uKey].totalOnTime += 1;
                }

                if (log.jamOut && log.jamOut !== '') {
                    summaryMap[uKey].totalLengkap += 1;
                } else {
                    summaryMap[uKey].totalBelumOut += 1;
                }

                if (!attendedDatesPerUser[uKey]) attendedDatesPerUser[uKey] = new Set();
                attendedDatesPerUser[uKey].add(log.tanggal);
            });

            Object.keys(summaryMap).forEach(uKey => {
                const hadirUnikHari = attendedDatesPerUser[uKey] ? attendedDatesPerUser[uKey].size : 0;
                summaryMap[uKey].totalBelumIn = Math.max(0, totalDaysInRange - hadirUnikHari);
            });

            tableState.summary.data = Object.values(summaryMap);
            tableState.summary.page = 1;
            renderTable('summary');
        }

        function setSummaryRangeAllTime() {
            document.getElementById('sumStartDate').value = '';
            document.getElementById('sumEndDate').value = '';
            recalculateSummaryByDateRange();
        }

        // ================= SALES FLOW (AUTO-RESET PER HARI & KUNCI CLOCK-OUT) =================
        function applyWorkSettingsToUI() {
            document.getElementById('salesRuleIn').textContent = workSettings.maxClockIn + ' WIB';
            document.getElementById('salesRuleOut').textContent = workSettings.minClockOut + ' WIB';
            document.getElementById('headerBadgeMaxIn').textContent = workSettings.maxClockIn;
            document.getElementById('headerBadgeMinOut').textContent = workSettings.minClockOut;
            document.getElementById('subLabelMaxIn').textContent = workSettings.maxClockIn;
            document.getElementById('subLabelLateIn').textContent = workSettings.maxClockIn;
            document.getElementById('setMaxClockIn').value = workSettings.maxClockIn;
            document.getElementById('setMinClockOut').value = workSettings.minClockOut;
        }

        function loadSalesDashboard() {
            document.getElementById('salesProfileName').textContent = currentUser.nama;
            document.getElementById('salesBadgeStatus').textContent = currentUser.status;
            document.getElementById('salesProfProv').textContent = currentUser.provinsi;
            document.getElementById('salesProfStasiun').textContent = currentUser.stasiun;

            showLoading('Memuat status kehadiran hari ini...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (res.settings) {
                    workSettings = res.settings;
                    applyWorkSettingsToUI();
                }
                document.getElementById('salesTodayDateLabel').textContent = res.serverDate;

                const rec = res.todayRecord;
                const btnIn = document.getElementById('btnClockIn');
                const btnOut = document.getElementById('btnClockOut');
                const boxIn = document.getElementById('statusBoxIn');
                const badgeIn = document.getElementById('badgeBoxIn');
                const boxOut = document.getElementById('statusBoxOut');
                const badgeOut = document.getElementById('badgeBoxOut');
                const durEl = document.getElementById('salesWorkDuration');
                const noticeEl = document.getElementById('salesLockNotice');

                // Jika di hari ini belum ada record (atau sudah ganti hari baru), otomatis reset ke Belum Absen
                if (!rec) {
                    boxIn.textContent = 'Belum Clock-In';
                    badgeIn.classList.add('hidden');
                    boxOut.textContent = 'Terkunci';
                    badgeOut.classList.add('hidden');
                    durEl.textContent = 'Menunggu Clock-In';
                    btnIn.disabled = false;
                    btnOut.disabled = true; // Tidak bisa Clock-Out kalau belum Clock-In
                    noticeEl.textContent = 'Anda wajib melakukan Clock-In terlebih dahulu sebelum bisa melakukan Clock-Out.';
                } else {
                    boxIn.textContent = rec.jamIn || '--:--';
                    badgeIn.textContent = rec.statusIn;
                    badgeIn.className = `text-[10px] font-bold px-1.5 py-0.5 rounded mt-1 inline-block ${rec.statusIn === 'Late' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-teal-50 text-teal-700 border border-teal-200'
                        }`;
                    btnIn.disabled = true;

                    if (rec.jamOut) {
                        boxOut.textContent = rec.jamOut;
                        badgeOut.textContent = 'Completed';
                        badgeOut.className = 'text-[10px] font-bold px-1.5 py-0.5 rounded mt-1 inline-block bg-emerald-50 text-emerald-700 border border-emerald-200';
                        durEl.textContent = calcDurationLabel(rec.jamIn, rec.jamOut);
                        btnOut.disabled = true;
                        noticeEl.textContent = 'Absensi Clock-In dan Clock-Out Anda untuk hari ini telah lengkap.';
                    } else {
                        boxOut.textContent = 'Belum Clock-Out';
                        badgeOut.classList.add('hidden');
                        durEl.textContent = 'Sedang Bertugas';
                        btnOut.disabled = false;
                        noticeEl.textContent = `Tombol Clock-Out dapat digunakan setelah pukul ${workSettings.minClockOut} WIB.`;
                    }
                }

                tableState.salesHistory.data = res.history || [];
                document.getElementById('salesHistCountLabel').textContent = `${tableState.salesHistory.data.length} riwayat`;
                renderTable('salesHistory');
            }).getSalesTodayStatus(currentUser.username);
        }

        async function openAttendanceModal(type) {
            if (type === 'OUT') {
                const nowStr = new Date().toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false });
                const parts = nowStr.split(':').map(Number);
                const nowSec = (parts[0] * 3600) + (parts[1] * 60) + (parts[2] || 0);
                const [minH, minM] = workSettings.minClockOut.split(':').map(Number);
                const minOutSec = (minH * 3600) + ((minM || 0) * 60);

                if (nowSec < minOutSec) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Belum Waktunya Clock-Out',
                        text: `Clock-Out baru dibuka minimal pukul ${workSettings.minClockOut} WIB.`,
                        confirmButtonColor: '#0f766e'
                    });
                    return;
                }
            }

            currentAttendanceType = type;
            nativePhotoBase64 = null;
            document.getElementById('nativeCameraInput').value = '';
            document.getElementById('photoPreview').classList.add('hidden');
            document.getElementById('cameraStream').classList.remove('hidden');
            document.getElementById('cameraFallbackOverlay').classList.add('hidden');
            document.getElementById('cameraFallbackOverlay').classList.remove('flex');

            document.getElementById('modalTitle').textContent = type === 'IN' ? 'Konfirmasi Clock-In (Masuk)' : 'Konfirmasi Clock-Out (Pulang)';
            document.getElementById('cameraModal').classList.remove('hidden');
            document.getElementById('cameraModal').classList.add('flex');
            updateSubmitButtonState();

            await retryLiveCamera();
            fetchGpsLocation();
        }

        async function retryLiveCamera() {
            stopCameraStream();
            nativePhotoBase64 = null;
            document.getElementById('photoPreview').classList.add('hidden');
            document.getElementById('cameraStream').classList.remove('hidden');
            document.getElementById('cameraFallbackOverlay').classList.add('hidden');
            document.getElementById('cameraFallbackOverlay').classList.remove('flex');

            try {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    throw new Error('Tidak tersedia');
                }
                try {
                    mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
                } catch (e) {
                    mediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                }
                const videoEl = document.getElementById('cameraStream');
                videoEl.srcObject = mediaStream;
                await videoEl.play();
                updateSubmitButtonState();
            } catch (err) {
                document.getElementById('cameraFallbackOverlay').classList.remove('hidden');
                document.getElementById('cameraFallbackOverlay').classList.add('flex');
                updateSubmitButtonState();
            }
        }

        function handleNativePhoto(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = new Image();
                img.onload = function () {
                    const canvas = document.getElementById('cameraCanvas');
                    const maxW = 480;
                    const scale = maxW / img.width;
                    canvas.width = maxW;
                    canvas.height = img.height * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    nativePhotoBase64 = canvas.toDataURL('image/jpeg', 0.7);

                    stopCameraStream();
                    document.getElementById('cameraStream').classList.add('hidden');
                    document.getElementById('cameraFallbackOverlay').classList.add('hidden');
                    document.getElementById('cameraFallbackOverlay').classList.remove('flex');

                    const previewEl = document.getElementById('photoPreview');
                    previewEl.src = nativePhotoBase64;
                    previewEl.classList.remove('hidden');
                    updateSubmitButtonState();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function fetchGpsLocation() {
            const gpsText = document.getElementById('gpsStatusText');
            gpsText.textContent = 'Mencari koordinat GPS...';
            gpsText.className = 'font-mono-code text-amber-600';
            updateSubmitButtonState();

            if (!navigator.geolocation) {
                gpsText.textContent = 'Browser tidak mendukung GPS.';
                return;
            }

            navigator.geolocation.getCurrentPosition(
                pos => {
                    currentLocation.lat = pos.coords.latitude.toFixed(6);
                    currentLocation.lng = pos.coords.longitude.toFixed(6);
                    gpsText.textContent = `${currentLocation.lat}, ${currentLocation.lng}`;
                    gpsText.className = 'font-mono-code text-teal-700 font-bold';
                    updateSubmitButtonState();
                },
                err => {
                    gpsText.textContent = 'Izin GPS ditolak. Izinkan Location di ikon Gembok URL Chrome.';
                    gpsText.className = 'font-mono-code text-rose-600 text-[10.5px]';
                },
                { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
            );
        }

        function updateSubmitButtonState() {
            const hasGps = !!(currentLocation.lat && currentLocation.lng);
            const hasCam = !!(mediaStream || nativePhotoBase64);
            document.getElementById('btnSubmitCapture').disabled = !(hasGps && hasCam);
        }

        function stopCameraStream() {
            if (mediaStream) {
                mediaStream.getTracks().forEach(t => t.stop());
                mediaStream = null;
            }
        }

        function closeAttendanceModal() {
            stopCameraStream();
            document.getElementById('cameraModal').classList.add('hidden');
            document.getElementById('cameraModal').classList.remove('flex');
        }

        function captureAndSubmit() {
            let finalImageBase64 = nativePhotoBase64;
            if (!finalImageBase64 && mediaStream) {
                const video = document.getElementById('cameraStream');
                const canvas = document.getElementById('cameraCanvas');
                canvas.width = 480;
                canvas.height = 640;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                finalImageBase64 = canvas.toDataURL('image/jpeg', 0.7);
            }

            closeAttendanceModal();
            showLoading('Menyimpan foto ke Drive & mencatat koordinat...');

            const payload = {
                type: currentAttendanceType,
                username: currentUser.username,
                nama: currentUser.nama,
                status: currentUser.status,
                provinsi: currentUser.provinsi,
                stasiun: currentUser.stasiun,
                lat: currentLocation.lat,
                lng: currentLocation.lng,
                imageBase64: finalImageBase64
            };

            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Berhasil', text: res.message, confirmButtonColor: '#0f766e' });
                    loadSalesDashboard();
                } else {
                    Swal.fire({ icon: 'error', title: 'Ditolak', text: res.message, confirmButtonColor: '#0f766e' });
                }
            }).submitAttendance(payload);
        }

        // ================= ADMIN FLOW =================
        function stepAdminDate(days) {
            const input = document.getElementById('adminDateFilter');
            const curr = new Date(input.value || new Date());
            curr.setDate(curr.getDate() + days);
            const iso = curr.toISOString().split('T')[0];
            input.value = iso;
            onHeaderDateChange();
        }

        function onHeaderDateChange() {
            const selectedDate = document.getElementById('adminDateFilter').value;
            // Sinkronkan filter tanggal di tab Rekap Akumulasi agar langsung melihat akumulasi tanggal tersebut
            document.getElementById('sumStartDate').value = selectedDate;
            document.getElementById('sumEndDate').value = selectedDate;
            loadAdminData();
        }

        function switchAdminTab(tabId) {
            const allTabs = ['tabMonitoring', 'tabBelumAbsen', 'tabSummary', 'tabAllLogs', 'tabUsers', 'tabSettings'];
            const titles = {
                tabMonitoring: 'Attendance Harian',
                tabBelumAbsen: 'Daftar Belum Clock-In',
                tabSummary: 'Database Akumulasi Kehadiran Per Tanggal',
                tabAllLogs: 'Semua Database Absensi',
                tabUsers: 'Kelola Akun Sales & Admin',
                tabSettings: 'Pengaturan Jam Kerja'
            };

            allTabs.forEach(id => {
                document.getElementById(id).classList.add('hidden');
                const topBtn = document.getElementById(`navBtn_${id}`);
                if (topBtn) {
                    topBtn.className = 'px-2.5 py-1 rounded text-[11px] font-semibold text-slate-400 hover:text-white transition flex items-center gap-1';
                }
                const sideBtn = document.getElementById(`sideBtn_${id}`);
                if (sideBtn) {
                    sideBtn.className = 'w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition';
                }
            });

            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById('adminPageTitle').textContent = titles[tabId] || 'Attendance';

            const activeTop = document.getElementById(`navBtn_${tabId}`);
            if (activeTop) {
                activeTop.className = 'px-2.5 py-1 rounded text-[11px] font-semibold bg-[#2c374b] text-white transition flex items-center gap-1';
            }
            const activeSide = document.getElementById(`sideBtn_${tabId}`);
            if (activeSide) {
                activeSide.className = 'w-8 h-8 rounded-lg flex items-center justify-center text-teal-700 bg-teal-50 transition';
            }
        }

        function loadAdminData() {
            const selectedDate = document.getElementById('adminDateFilter').value;
            document.querySelectorAll('.lblSelectedDate').forEach(el => { el.textContent = selectedDate; });
            showLoading('Menyinkronkan database...');

            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (res.settings) {
                    workSettings = res.settings;
                    applyWorkSettingsToUI();
                }

                masterSalesOnly = res.salesOnly || [];
                tableState.todayLogs.data = res.todayLogs || [];
                tableState.belumAbsen.data = res.belumAbsen || [];
                tableState.allLogs.data = res.allLogs || [];
                tableState.users.data = res.users || [];

                const totalSales = masterSalesOnly.length;
                const onTimeCount = tableState.todayLogs.data.filter(l => l.statusIn === 'On Time').length;
                const lateCount = tableState.todayLogs.data.filter(l => l.statusIn === 'Late').length;
                const clockedOutCount = tableState.todayLogs.data.filter(l => l.jamOut !== '').length;
                const noClockOutCount = tableState.todayLogs.data.filter(l => l.jamOut === '').length;
                const belumCount = tableState.belumAbsen.data.length;
                const rate = totalSales > 0 ? Math.round((tableState.todayLogs.data.length / totalSales) * 100) : 0;

                document.getElementById('kpiTotalSales').textContent = totalSales;
                document.getElementById('kpiOnTime').textContent = onTimeCount;
                document.getElementById('kpiLate').textContent = lateCount;
                document.getElementById('kpiClockedOut').textContent = clockedOutCount;
                document.getElementById('kpiBelumAbsen').textContent = belumCount;
                document.getElementById('kpiBelumOut').textContent = noClockOutCount;
                document.getElementById('kpiAttendanceRate').textContent = rate + '%';

                document.getElementById('badgeNavBelum').textContent = belumCount;
                document.getElementById('badgeNavLate').textContent = lateCount;

                // Hitung akumulasi sesuai tanggal yang dipilih
                recalculateSummaryByDateRange();

                renderTable('todayLogs');
                renderTable('belumAbsen');
                renderTable('allLogs');
                renderTable('users');
            }).getAdminDashboardData(selectedDate);
        }

        function handleSaveSettings(e) {
            e.preventDefault();
            const maxIn = document.getElementById('setMaxClockIn').value;
            const minOut = document.getElementById('setMinClockOut').value;

            showLoading('Menyimpan aturan jam kerja...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (res.success) {
                    workSettings = res.settings;
                    applyWorkSettingsToUI();
                    Swal.fire({ icon: 'success', title: 'Tersimpan', text: res.message, confirmButtonColor: '#0f766e' });
                }
            }).saveWorkTimeSettings(maxIn, minOut);
        }

        // ================= ADMIN USER CRUD & CASCADE DELETE =================
        function handleSaveUser(e) {
            e.preventDefault();
            const userObj = {
                id: document.getElementById('usrId').value,
                nama: document.getElementById('usrNama').value.trim(),
                username: document.getElementById('usrUsername').value.trim(),
                password: document.getElementById('usrPassword').value.trim(),
                role: document.getElementById('usrRole').value,
                status: document.getElementById('usrStatus').value,
                provinsi: document.getElementById('usrProvinsi').value.trim(),
                stasiun: document.getElementById('usrStasiun').value.trim()
            };

            showLoading('Menyimpan data akun...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Berhasil', text: res.message, confirmButtonColor: '#0f766e' });
                    resetUserForm();
                    loadAdminData();
                } else {
                    Swal.fire({ icon: 'error', title: 'Gagal', text: res.message, confirmButtonColor: '#0f766e' });
                }
            }).saveUserAdmin(userObj);
        }

        function editUser(u) {
            document.getElementById('formUserTitle').textContent = 'Edit Akun: ' + u.nama;
            document.getElementById('usrId').value = u.id;
            document.getElementById('usrNama').value = u.nama;
            document.getElementById('usrUsername').value = u.username;
            document.getElementById('usrPassword').value = u.password;
            document.getElementById('usrRole').value = u.role;
            document.getElementById('usrStatus').value = u.status;
            document.getElementById('usrProvinsi').value = u.provinsi;
            document.getElementById('usrStasiun').value = u.stasiun;
        }

        function resetUserForm() {
            document.getElementById('formUserTitle').textContent = 'Tambah User / Sales Baru';
            document.getElementById('userForm').reset();
            document.getElementById('usrId').value = '';
        }

        function deleteUser(id, nama) {
            Swal.fire({
                title: `Hapus Akun ${nama}?`,
                text: 'Seluruh data akun DAN semua riwayat absensi milik orang ini akan dihapus permanen agar rasio % kehadiran tetap akurat.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: 'Ya, Hapus Semua!',
                cancelButtonText: 'Batal'
            }).then(result => {
                if (result.isConfirmed) {
                    showLoading('Menghapus akun & seluruh riwayat absensinya...');
                    google.script.run.withSuccessHandler(res => {
                        hideLoading();
                        Swal.fire({ icon: 'success', title: 'Terhapus', text: res.message, confirmButtonColor: '#0f766e' });
                        loadAdminData();
                    }).deleteUserAdmin(id);
                }
            });
        }
    </script>
</body>

</html>