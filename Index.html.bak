                                        <th class="tiimi-filter-cell"><input type="text" id="flt_todayLogs_stasiun"
                                                oninput="updateTableFilter('todayLogs', 'stasiun', this.value)"
                                                placeholder="Stasiun..." class="tiimi-filter-input"></th>
