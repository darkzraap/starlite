                    <!-- ================= TAB 3: REKAP AKUMULASI KEHADIRAN PER TANGGAL ================= -->
                    <div id="tabSummary"
                        class="hidden bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div
                            class="px-4 py-2.5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2 bg-slate-50/60">
                            <div>
                                <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-800">Database
                                    Akumulasi Kehadiran Per Tanggal / Periode</h3>
                                <p class="text-[10.5px] text-slate-500">Pilih tanggal awal & akhir untuk melihat
                                    akumulasi Belum Clock-In, On Time, Late, Belum Clock-Out, dan Lengkap (In+Out).</p>
                            </div>

                            <!-- Filter Rentang Tanggal Akumulasi -->
                            <div class="flex flex-wrap items-center gap-1.5">
                                <span class="text-[10.5px] font-semibold text-slate-600">Periode:</span>
                                <input type="date" id="sumStartDate" onchange="recalculateSummaryByDateRange()"
                                    class="px-2 py-1 bg-white border border-slate-300 rounded text-[11px] font-bold text-slate-800">
                                <span class="text-slate-400">s/d</span>
                                <input type="date" id="sumEndDate" onchange="recalculateSummaryByDateRange()"
                                    class="px-2 py-1 bg-white border border-slate-300 rounded text-[11px] font-bold text-slate-800">
                                <button onclick="setSummaryRangeAllTime()"
                                    class="px-2 py-1 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded text-[10.5px] font-semibold transition">
                                    Semua Tanggal
                                </button>
                                <button onclick="resetTableFilters('summary')"
                                    class="px-2 py-1 text-teal-600 hover:underline text-[10.5px] font-semibold">
                                    Reset Filter
                                </button>
                            </div>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr>
                                        <th class="tiimi-th">Nama Sales</th>
                                        <th class="tiimi-th">Status</th>
                                        <th class="tiimi-th">Provinsi</th>
                                        <th class="tiimi-th">Stasiun</th>
                                        <th class="tiimi-th text-center">Belum Clock-In</th>
                                        <th class="tiimi-th text-center">Total Hadir (In)</th>
                                        <th class="tiimi-th text-center">On Time</th>
                                        <th class="tiimi-th text-center">Late</th>
                                        <th class="tiimi-th text-center">Belum Clock-Out</th>
                                        <th class="tiimi-th text-center">Lengkap (In & Out)</th>
                                        <th class="tiimi-th text-center">Detail</th>
                                    </tr>
                                    <tr>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_summary_nama"
                                                oninput="updateTableFilter('summary', 'nama', this.value)"
                                                placeholder="Filter nama..." class="tiimi-filter-input"></th>
                                        <th class="tiimi-filter-cell">
                                            <select id="flt_summary_status"
                                                onchange="updateTableFilter('summary', 'status', this.value)"
                                                class="tiimi-filter-input">
                                                <option value="">Semua</option>
                                                <option value="Inhouse">Inhouse</option>
                                                <option value="Freelance">Freelance</option>
                                            </select>
                                        </th>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_summary_provinsi"
                                                oninput="updateTableFilter('summary', 'provinsi', this.value)"
