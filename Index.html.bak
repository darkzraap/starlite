                                    </tr>
                                    <tr>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_todayLogs_nama"
                                                oninput="updateTableFilter('todayLogs', 'nama', this.value)"
                                                placeholder="Cari nama / user..." class="tiimi-filter-input"></th>
                                        <th class="tiimi-filter-cell">
                                            <select id="flt_todayLogs_statusSales"
                                                onchange="updateTableFilter('todayLogs', 'statusSales', this.value)"
