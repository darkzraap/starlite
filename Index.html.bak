                    <!-- ================= TAB 5: KELOLA AKUN SALES (CRUD + TOMBOL DETAIL + CASCADE DELETE) ================= -->
                    <div id="tabUsers" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-4">
                        <div
                            class="lg:col-span-4 bg-white rounded-xl border border-slate-200 p-4 shadow-sm h-fit space-y-3">
                            <h3 id="formUserTitle"
                                class="text-xs font-bold text-slate-800 border-b border-slate-100 pb-2">Tambah User /
                                Sales Baru</h3>
                            <form id="userForm" onsubmit="handleSaveUser(event)" class="space-y-2.5 text-[11.5px]">
                                <input type="hidden" id="usrId">
                                <div>
                                    <label class="text-slate-600 font-semibold block mb-0.5">Nama Lengkap Sales</label>
                                    <input type="text" id="usrNama" required placeholder="Contoh: Bagus Fikri"
                                        class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:bg-white focus:border-teal-600 focus:outline-none">
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="text-slate-600 font-semibold block mb-0.5">Username Login</label>
                                        <input type="text" id="usrUsername" required placeholder="bagus01"
                                            class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:bg-white focus:border-teal-600 focus:outline-none">
                                    </div>
                                    <div>
                                        <label class="text-slate-600 font-semibold block mb-0.5">Password</label>
                                        <input type="text" id="usrPassword" required placeholder="Min. 4 karakter"
                                            class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:bg-white focus:border-teal-600 focus:outline-none">
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="text-slate-600 font-semibold block mb-0.5">Role Sistem</label>
                                        <select id="usrRole"
                                            class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800">
                                            <option value="Sales">Sales</option>
                                            <option value="Admin">Admin</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-slate-600 font-semibold block mb-0.5">Status Kontrak</label>
                                        <select id="usrStatus"
                                            class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800">
                                            <option value="Inhouse">Inhouse</option>
                                            <option value="Freelance">Freelance</option>
                                        </select>
                                    </div>
                                </div>
                                <div>
                                    <label class="text-slate-600 font-semibold block mb-0.5">Provinsi</label>
                                    <input type="text" id="usrProvinsi" required placeholder="Contoh: Jawa Barat"
                                        class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:bg-white focus:border-teal-600 focus:outline-none">
                                </div>
                                <div>
                                    <label class="text-slate-600 font-semibold block mb-0.5">Stasiun / Titik
                                        Penugasan</label>
                                    <input type="text" id="usrStasiun" required placeholder="Contoh: Stasiun Bandung"
                                        class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:bg-white focus:border-teal-600 focus:outline-none">
                                </div>
                                <div class="flex gap-2 pt-1.5">
                                    <button type="submit"
                                        class="flex-1 py-2 bg-[#0f766e] hover:bg-[#115e59] text-white font-bold rounded-lg transition">
                                        <i class="fa-solid fa-check mr-1"></i> Simpan Akun
                                    </button>
                                    <button type="button" onclick="resetUserForm()"
                                        class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition">
                                        Batal
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div
                            class="lg:col-span-8 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                            <div class="px-4 py-2.5 border-b border-slate-200 flex items-center justify-between">
                                <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700">Database Akun
                                    Sales & Admin</h3>
                                <button onclick="resetTableFilters('users')"
                                    class="text-[11px] text-teal-600 hover:underline font-semibold">Reset
                                    Filter</button>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr>
                                            <th class="tiimi-th">Nama Personel</th>
                                            <th class="tiimi-th">Username & Pass</th>
                                            <th class="tiimi-th">Role</th>
                                            <th class="tiimi-th">Status</th>
                                            <th class="tiimi-th">Provinsi</th>
                                            <th class="tiimi-th">Stasiun</th>
                                            <th class="tiimi-th text-center">Detail & Aksi</th>
                                        </tr>
                                        <tr>
                                            <th class="tiimi-filter-cell"><input type="text" id="flt_users_nama"
                                                    oninput="updateTableFilter('users', 'nama', this.value)"
                                                    placeholder="Filter nama..." class="tiimi-filter-input"></th>
                                            <th class="tiimi-filter-cell"><input type="text" id="flt_users_username"
                                                    oninput="updateTableFilter('users', 'username', this.value)"
                                                    placeholder="Filter user..." class="tiimi-filter-input"></th>
                                            <th class="tiimi-filter-cell">
                                                <select id="flt_users_role"
                                                    onchange="updateTableFilter('users', 'role', this.value)"
                                                    class="tiimi-filter-input">
                                                    <option value="">Semua</option>
                                                    <option value="Sales">Sales</option>
                                                    <option value="Admin">Admin</option>
                                                </select>
                                            </th>
                                            <th class="tiimi-filter-cell">
                                                <select id="flt_users_status"
                                                    onchange="updateTableFilter('users', 'status', this.value)"
                                                    class="tiimi-filter-input">
                                                    <option value="">Semua</option>
                                                    <option value="Inhouse">Inhouse</option>
                                                    <option value="Freelance">Freelance</option>
                                                </select>
                                            </th>
                                            <th class="tiimi-filter-cell"><input type="text" id="flt_users_provinsi"
                                                    oninput="updateTableFilter('users', 'provinsi', this.value)"
                                                    placeholder="Provinsi..." class="tiimi-filter-input"></th>
                                            <th class="tiimi-filter-cell"><input type="text" id="flt_users_stasiun"
                                                    oninput="updateTableFilter('users', 'stasiun', this.value)"
                                                    placeholder="Stasiun..." class="tiimi-filter-input"></th>
                                            <th class="tiimi-filter-cell"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody_users"></tbody>
                                </table>
                            </div>
                            <div id="pager_users"
                                class="px-4 py-2 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2 text-[11px]">
                            </div>
                        </div>
                    </div>

                    <!-- ================= TAB 6: PENGATURAN JAM KERJA DINAMIS ================= -->
                    <div id="tabSettings" class="hidden max-w-lg mx-auto">
                        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 space-y-4">
                            <div class="flex items-start justify-between border-b border-slate-100 pb-3">
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">Pengaturan Batas Jam Absensi</h3>
                                    <p class="text-[11px] text-slate-500 mt-0.5">Ubah batas jam keterlambatan Clock-In
                                        dan jam minimal Clock-Out.</p>
                                </div>
                                <span
                                    class="px-2 py-0.5 rounded bg-teal-50 text-teal-700 font-bold text-[10px] border border-teal-200">Admin
                                    Only</span>
                            </div>

                            <form onsubmit="handleSaveSettings(event)" class="space-y-3.5">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200 space-y-1.5">
                                        <label class="block text-[11px] font-bold text-slate-700 uppercase">Batas Jam
                                            Clock-In (On Time)</label>
                                        <input type="time" id="setMaxClockIn" required
                                            class="w-full px-2.5 py-1.5 bg-white border border-slate-300 rounded font-mono-code text-sm font-bold text-slate-900 focus:outline-none focus:border-teal-600">
                                        <p class="text-[10.5px] text-slate-500">Lewat dari jam ini otomatis berstatus
                                            <strong class="text-amber-600">Late</strong>.</p>
                                    </div>

                                    <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200 space-y-1.5">
                                        <label class="block text-[11px] font-bold text-slate-700 uppercase">Minimal Jam
                                            Clock-Out</label>
                                        <input type="time" id="setMinClockOut" required
                                            class="w-full px-2.5 py-1.5 bg-white border border-slate-300 rounded font-mono-code text-sm font-bold text-slate-900 focus:outline-none focus:border-teal-600">
                                        <p class="text-[10.5px] text-slate-500">Sales wajib Clock-In dulu & baru bisa
                                            Clock-Out minimal jam ini.</p>
                                    </div>
                                </div>

                                <div class="flex items-center justify-end pt-1">
                                    <button type="submit"
                                        class="px-4 py-2 bg-[#0f766e] hover:bg-[#115e59] text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        <span>Simpan Pengaturan</span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <!-- ================= MODAL DETAIL RIWAYAT PERSONEL (ADMIN) ================= -->
    <div id="userDetailModal"
        class="fixed inset-0 bg-slate-900/70 backdrop-blur-[1px] z-40 hidden items-center justify-center p-3 overflow-y-auto">
        <div class="bg-white w-full max-w-4xl rounded-xl border border-slate-200 shadow-2xl overflow-hidden my-auto">
            <div class="bg-[#1c2434] text-white px-5 py-3.5 flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 id="detailModalName" class="font-bold text-sm text-white">Nama Sales</h3>
                        <span id="detailModalBadge"
                            class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-500/20 text-teal-300 border border-teal-400/30"></span>
                    </div>
                    <p id="detailModalSub" class="text-[11px] text-slate-300 mt-0.5"></p>
                </div>
                <button onclick="closeUserDetailModal()"
                    class="w-7 h-7 rounded-lg bg-white/10 hover:bg-rose-600 text-white flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Ringkasan Statistik Orang Tersebut -->
            <div
                class="grid grid-cols-4 divide-x divide-slate-200 bg-slate-50 border-b border-slate-200 text-center py-2.5">
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Total Hadir</span>
                    <span id="detStatHadir" class="text-sm font-extrabold text-slate-900">0</span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">On Time</span>
                    <span id="detStatOnTime" class="text-sm font-extrabold text-teal-600">0</span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Terlambat (Late)</span>
                    <span id="detStatLate" class="text-sm font-extrabold text-amber-600">0</span>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Lengkap Clock-Out</span>
                    <span id="detStatOut" class="text-sm font-extrabold text-indigo-600">0</span>
                </div>
            </div>

            <!-- Tabel Semua Tanggal Clock-In, Clock-Out, Maps & Foto Milik Orang Tersebut -->
            <div class="max-h-[60vh] overflow-y-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10">
                        <tr>
                            <th class="tiimi-th">Tanggal</th>
                            <th class="tiimi-th">Jam Clock-In</th>
                            <th class="tiimi-th">Status In</th>
                            <th class="tiimi-th">Maps & Foto In</th>
                            <th class="tiimi-th">Jam Clock-Out</th>
                            <th class="tiimi-th">Status Out</th>
                            <th class="tiimi-th">Maps & Foto Out</th>
                        </tr>
                        <tr>
                            <th class="tiimi-filter-cell"><input type="text" id="flt_userDetail_tanggal"
                                    oninput="updateTableFilter('userDetail', 'tanggal', this.value)"
                                    placeholder="Cari tanggal..." class="tiimi-filter-input"></th>
                            <th class="tiimi-filter-cell"><input type="text" id="flt_userDetail_jamIn"
                                    oninput="updateTableFilter('userDetail', 'jamIn', this.value)"
                                    placeholder="Jam In..." class="tiimi-filter-input"></th>
                            <th class="tiimi-filter-cell">
                                <select id="flt_userDetail_statusIn"
                                    onchange="updateTableFilter('userDetail', 'statusIn', this.value)"
                                    class="tiimi-filter-input">
                                    <option value="">Semua</option>
                                    <option value="On Time">On Time</option>
                                    <option value="Late">Late</option>
                                </select>
                            </th>
                            <th class="tiimi-filter-cell"></th>
                            <th class="tiimi-filter-cell"><input type="text" id="flt_userDetail_jamOut"
                                    oninput="updateTableFilter('userDetail', 'jamOut', this.value)"
                                    placeholder="Jam Out..." class="tiimi-filter-input"></th>
                            <th class="tiimi-filter-cell">
                                <select id="flt_userDetail_statusOut"
                                    onchange="updateTableFilter('userDetail', 'statusOut', this.value)"
                                    class="tiimi-filter-input">
                                    <option value="">Semua</option>
                                    <option value="Completed">Lengkap</option>
                                    <option value="Belum Clock-Out">Belum Out</option>
                                </select>
                            </th>
                            <th class="tiimi-filter-cell"></th>
                        </tr>
                    </thead>
                    <tbody id="tbody_userDetail"></tbody>
                </table>
            </div>
            <div id="pager_userDetail"
                class="px-4 py-2 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-[11px]">
            </div>
        </div>
    </div>

    <!-- ================= MODAL KAMERA & GPS SALES ================= -->
    <div id="cameraModal"
        class="fixed inset-0 bg-slate-900/75 backdrop-blur-sm z-40 hidden items-center justify-center p-3 overflow-y-auto">
        <div class="bg-white w-full max-w-sm rounded-xl p-4 space-y-3 border border-slate-200 shadow-2xl my-auto">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                <h3 id="modalTitle" class="font-bold text-slate-900 text-xs">Verifikasi Kamera & Lokasi</h3>
                <button onclick="closeAttendanceModal()"
                    class="w-6 h-6 rounded bg-slate-100 text-slate-500 hover:text-slate-900 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div
                class="relative bg-slate-950 rounded-lg overflow-hidden aspect-[3/4] max-h-64 mx-auto flex flex-col items-center justify-center border border-slate-200">
                <video id="cameraStream" autoplay playsinline muted class="w-full h-full object-cover"></video>
                <img id="photoPreview" src="" class="hidden w-full h-full object-cover" alt="Preview">
                <canvas id="cameraCanvas" class="hidden"></canvas>

                <div id="cameraFallbackOverlay"
                    class="hidden absolute inset-0 bg-slate-900/95 p-4 flex-col items-center justify-center text-center space-y-2.5">
                    <i class="fa-solid fa-camera text-xl text-amber-400"></i>
                    <p class="text-[11px] text-white font-semibold">Izin Live Kamera Tertahan oleh Iframe Browser</p>
                    <label for="nativeCameraInput"
                        class="cursor-pointer px-3 py-2 bg-teal-600 hover:bg-teal-500 text-white text-[11px] font-bold rounded-lg shadow inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-camera"></i> Buka Kamera Perangkat
                    </label>
                </div>
            </div>

            <input type="file" id="nativeCameraInput" accept="image/*" capture="user"
                onchange="handleNativePhoto(event)" class="hidden">

            <div class="flex items-center justify-between text-[11px]">
                <button type="button" onclick="retryLiveCamera()"
                    class="text-teal-700 font-semibold hover:underline flex items-center gap-1">
                    <i class="fa-solid fa-video"></i> Muat Ulang Kamera
                </button>
                <label for="nativeCameraInput"
                    class="cursor-pointer text-slate-600 font-semibold hover:underline flex items-center gap-1">
                    <i class="fa-solid fa-mobile-screen"></i> Kamera Sistem HP
                </label>
            </div>

            <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-200 text-[11px] space-y-0.5">
                <div class="flex items-center justify-between">
                    <span class="text-slate-500 font-semibold"><i
                            class="fa-solid fa-location-crosshairs text-teal-600 mr-1"></i> Koordinat GPS:</span>
                    <button type="button" onclick="fetchGpsLocation()"
                        class="text-teal-700 font-semibold hover:underline"><i class="fa-solid fa-rotate"></i> Refresh
                        GPS</button>
                </div>
                <p id="gpsStatusText" class="font-mono-code text-amber-600 font-medium">Mencari titik koordinat...</p>
            </div>

            <button id="btnSubmitCapture" onclick="captureAndSubmit()" disabled
                class="w-full py-2.5 bg-[#0f766e] hover:bg-[#115e59] disabled:bg-slate-200 disabled:text-slate-400 text-white font-bold text-xs rounded-lg shadow-sm transition flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-paper-plane"></i> Ambil Foto & Kirim Absensi
            </button>
        </div>
    </div>

    <script>
        const SESSION_STORAGE_KEY = 'STARLITE_AUTH_SESSION_V3';
        const PAGE_SIZE = 30; // 30 data per halaman

        let currentUser = null;
        let workSettings = { maxClockIn: '09:00', minClockOut: '18:00' };
        let currentAttendanceType = 'IN';
        let mediaStream = null;
        let nativePhotoBase64 = null;
        let currentLocation = { lat: null, lng: null };
        let masterSalesOnly = [];

        const tableState = {
            todayLogs: { data: [], filters: {}, page: 1 },
            belumAbsen: { data: [], filters: {}, page: 1 },
            summary: { data: [], filters: {}, page: 1 },
            allLogs: { data: [], filters: {}, page: 1 },
            users: { data: [], filters: {}, page: 1 },
            salesHistory: { data: [], filters: {}, page: 1 },
            userDetail: { data: [], filters: {}, page: 1 }
        };

        window.onload = () => {
            const now = new Date();
            const offsetMs = now.getTimezoneOffset() * 60000;
            const wibDate = new Date(now.getTime() + offsetMs + (7 * 3600000));
            const todayIso = wibDate.toISOString().split('T')[0];

            document.getElementById('adminDateFilter').value = todayIso;
            document.getElementById('sumStartDate').value = todayIso;
            document.getElementById('sumEndDate').value = todayIso;
            document.getElementById('salesTodayDateLabel').textContent = todayIso;

            google.script.run.withSuccessHandler(url => {
                if (url) {
                    document.getElementById('appLogoLogin').src = url;
                    document.getElementById('appLogoNav').src = url;
                }
            }).getLogoUrl();

            setInterval(() => {
                const d = new Date();
                const tStr = d.toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false });
                const el1 = document.getElementById('liveClock');
                const el2 = document.getElementById('salesMobileClock');
                if (el1) el1.textContent = tStr + ' WIB';
                if (el2) el2.textContent = tStr;
            }, 1000);

            // Persistent Login Session
            const savedSession = localStorage.getItem(SESSION_STORAGE_KEY);
            if (savedSession) {
                try {
                    const parsed = JSON.parse(savedSession);
                    if (parsed && parsed.username) {
                        currentUser = parsed;
                        enterAuthenticatedView();
                    }
                } catch (e) {
                    localStorage.removeItem(SESSION_STORAGE_KEY);
                }
            }
        };

        function showLoading(text = 'Memuat data...') {
            document.getElementById('loadingText').textContent = text;
            document.getElementById('loadingOverlay').classList.remove('hidden');
            document.getElementById('loadingOverlay').classList.add('flex');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.add('hidden');
            document.getElementById('loadingOverlay').classList.remove('flex');
        }

        // ================= AUTHENTICATION =================
        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('loginUsername').value;
            const p = document.getElementById('loginPassword').value;
            showLoading('Memverifikasi akun...');

            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (!res.success) {
                    Swal.fire({ icon: 'error', title: 'Login Gagal', text: res.message, confirmButtonColor: '#0f766e' });
                    return;
                }
                currentUser = res.user;
                if (res.settings) workSettings = res.settings;

                localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(currentUser));
                enterAuthenticatedView();
            }).loginUser(u, p);
        }

        function enterAuthenticatedView() {
            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('appShell').classList.remove('hidden');

            document.getElementById('navUserName').textContent = currentUser.nama;
            document.getElementById('navUserSub').textContent = `${currentUser.role} • ${currentUser.stasiun}`;

            const isAdmin = String(currentUser.role).toLowerCase() === 'admin';
            if (isAdmin) {
                document.getElementById('adminTopNav').classList.remove('hidden');
                document.getElementById('adminLeftSidebar').classList.remove('hidden');
                document.getElementById('salesView').classList.add('hidden');
                document.getElementById('adminView').classList.remove('hidden');
                loadAdminData();
            } else {
                document.getElementById('adminTopNav').classList.add('hidden');
                document.getElementById('adminLeftSidebar').classList.add('hidden');
                document.getElementById('adminView').classList.add('hidden');
                document.getElementById('salesView').classList.remove('hidden');
                loadSalesDashboard();
            }
        }

        function handleLogout() {
            stopCameraStream();
            localStorage.removeItem(SESSION_STORAGE_KEY);
            currentUser = null;
            document.getElementById('appShell').classList.add('hidden');
            document.getElementById('loginView').classList.remove('hidden');
            document.getElementById('loginPassword').value = '';
        }

        // ================= GENERIC FILTER & 30-ROW PAGINATION =================
        function updateTableFilter(tableKey, colName, val) {
            tableState[tableKey].filters[colName] = String(val || '').toLowerCase().trim();
            tableState[tableKey].page = 1;
            renderTable(tableKey);
        }

        function resetTableFilters(tableKey) {
            tableState[tableKey].filters = {};
            tableState[tableKey].page = 1;
            const inputs = document.querySelectorAll(`[id^="flt_${tableKey}_"]`);
            inputs.forEach(el => { el.value = ''; });
            renderTable(tableKey);
        }

        function changeTablePage(tableKey, newPage) {
            tableState[tableKey].page = newPage;
            renderTable(tableKey);
        }

        function getFilteredAndPagedData(tableKey) {
            const state = tableState[tableKey];
            const raw = state.data || [];
            const activeFilters = state.filters || {};

            const filtered = raw.filter(row => {
                for (const col in activeFilters) {
                    const fVal = activeFilters[col];
                    if (!fVal) continue;
                    let cellVal = String(row[col] !== undefined ? row[col] : '').toLowerCase();
                    if (col === 'nama' && row.username) {
                        cellVal += ' ' + String(row.username).toLowerCase();
                    }
                    if (col === 'jamIn' && row.jamOut) {
                        cellVal += ' ' + String(row.jamOut).toLowerCase();
                    }
                    if (!cellVal.includes(fVal)) return false;
                }
                return true;
            });

            const totalRows = filtered.length;
            const totalPages = Math.max(1, Math.ceil(totalRows / PAGE_SIZE));
            if (state.page > totalPages) state.page = totalPages;
            if (state.page < 1) state.page = 1;

            const startIdx = (state.page - 1) * PAGE_SIZE;
            const sliced = filtered.slice(startIdx, startIdx + PAGE_SIZE);

            return { sliced, totalRows, totalPages, currentPage: state.page, startIdx };
        }

        function renderPaginationBar(tableKey, meta) {
            const container = document.getElementById(`pager_${tableKey}`);
            if (!container) return;

            const fromRow = meta.totalRows === 0 ? 0 : meta.startIdx + 1;
            const toRow = Math.min(meta.startIdx + PAGE_SIZE, meta.totalRows);

            let pageButtons = '';
            const maxButtons = 5;
            let startPage = Math.max(1, meta.currentPage - 2);
            let endPage = Math.min(meta.totalPages, startPage + maxButtons - 1);
            if (endPage - startPage < maxButtons - 1) {
                startPage = Math.max(1, endPage - maxButtons + 1);
            }

            for (let p = startPage; p <= endPage; p++) {
                const activeClass = p === meta.currentPage
                    ? 'bg-[#1c2434] text-white font-bold border-[#1c2434]'
                    : 'bg-white text-slate-600 hover:bg-slate-100 border-slate-200';
                pageButtons += `<button onclick="changeTablePage('${tableKey}', ${p})" class="w-6 h-6 rounded border text-[11px] transition ${activeClass}">${p}</button>`;
            }

            container.innerHTML = `
        <div class="text-slate-500">
          Menampilkan <strong class="text-slate-800">${fromRow}–${toRow}</strong> dari <strong class="text-slate-800">${meta.totalRows}</strong> data (30/hal)
        </div>
        <div class="flex items-center gap-1">
          <button onclick="changeTablePage('${tableKey}', ${meta.currentPage - 1})" ${meta.currentPage <= 1 ? 'disabled' : ''}
            class="px-2 h-6 rounded border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-600 font-semibold">
            Prev
          </button>
          ${pageButtons}
          <button onclick="changeTablePage('${tableKey}', ${meta.currentPage + 1})" ${meta.currentPage >= meta.totalPages ? 'disabled' : ''}
            class="px-2 h-6 rounded border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-600 font-semibold">
            Next
          </button>
        </div>
      `;
        }

        function calcDurationLabel(jamIn, jamOut) {
            if (!jamIn || !jamOut) return 'Belum Out';
            const p1 = String(jamIn).split(':').map(Number);
            const p2 = String(jamOut).split(':').map(Number);
            if (p1.length < 2 || p2.length < 2) return '-';
            const m1 = (p1[0] * 60) + p1[1];
            const m2 = (p2[0] * 60) + p2[1];
            const diff = m2 - m1;
            if (diff <= 0) return '-';
            return `${Math.floor(diff / 60)}h ${diff % 60}m`;
        }

        // Render seluruh tabel tanpa badge foto profil
        function renderTable(tableKey) {
            const meta = getFilteredAndPagedData(tableKey);
            const tbody = document.getElementById(`tbody_${tableKey}`);
            if (!tbody) return;

            if (tableKey === 'todayLogs' || tableKey === 'allLogs') {
                const isAll = tableKey === 'allLogs';
                const colSpan = isAll ? 11 : 10;
                if (meta.sliced.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="${colSpan}" class="p-6 text-center text-slate-400">Tidak ada data absensi pada filter ini.</td></tr>`;
                } else {
                    tbody.innerHTML = meta.sliced.map(l => {
                        const isLate = l.statusIn === 'Late';
                        const inTimeColor = isLate ? 'text-amber-600 font-bold' : 'text-slate-800 font-semibold';
                        const outTimeLabel = l.jamOut ? `<span class="text-slate-800 font-semibold">${l.jamOut}</span>` : `<span class="text-rose-500 font-medium">--:--</span>`;
                        const durLabel = calcDurationLabel(l.jamIn, l.jamOut);

                        const statusInBadge = isLate
                            ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Late</span>`
                            : `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-teal-50 text-teal-700 border border-teal-200">On Time</span>`;

                        const statusOutBadge = l.jamOut
                            ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Lengkap</span>`
                            : `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-600 border border-rose-200">Belum Out</span>`;

                        const picCell = `
              <div class="flex items-center gap-1">
                ${l.fotoIn ? `<a href="${l.fotoIn}" target="_blank" class="px-1.5 py-0.5 rounded bg-slate-100 hover:bg-teal-50 text-teal-700 font-semibold text-[10.5px] border border-slate-200">Foto In</a>` : '-'}
                ${l.fotoOut ? `<a href="${l.fotoOut}" target="_blank" class="px-1.5 py-0.5 rounded bg-slate-100 hover:bg-indigo-50 text-indigo-700 font-semibold text-[10.5px] border border-slate-200">Foto Out</a>` : ''}
              </div>
            `;

                        const locCell = `
              <div class="flex flex-col gap-0.5">
                ${l.mapsIn ? `<a href="${l.mapsIn}" target="_blank" class="text-teal-700 hover:underline font-medium text-[10.5px]"><i class="fa-solid fa-location-dot"></i> In: ${l.koordinatIn}</a>` : '-'}
                ${l.mapsOut ? `<a href="${l.mapsOut}" target="_blank" class="text-indigo-700 hover:underline font-medium text-[10.5px]"><i class="fa-solid fa-location-dot"></i> Out: ${l.koordinatOut}</a>` : ''}
              </div>
            `;

                        return `
              <tr class="tiimi-row">
                ${isAll ? `<td class="tiimi-td font-mono-code text-[11px] text-slate-600 whitespace-nowrap">${l.tanggal}</td>` : ''}
                <td class="tiimi-td">
                  <div class="font-bold text-slate-900 leading-tight">${l.nama}</div>
                  <div class="text-[10px] text-slate-400 font-mono-code">${l.username}</div>
                </td>
                <td class="tiimi-td">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold ${l.statusSales === 'Inhouse' ? 'bg-blue-50 text-blue-700' : 'bg-purple-50 text-purple-700'}">${l.statusSales}</span>
                </td>
                <td class="tiimi-td text-slate-600">${l.provinsi}</td>
                <td class="tiimi-td font-semibold text-slate-700">${l.stasiun}</td>
                <td class="tiimi-td whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5 font-mono-code text-[11px]">
                    <span class="${inTimeColor}">${l.jamIn || '--:--'}</span>
                    <span class="text-[9.5px] font-sans text-slate-400 bg-slate-100 px-1.5 py-0.2 rounded">${durLabel}</span>
                    ${outTimeLabel}
                  </div>
                </td>
                <td class="tiimi-td">${statusInBadge}</td>
                <td class="tiimi-td">${statusOutBadge}</td>
