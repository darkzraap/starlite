                ${h.mapsIn ? `<a href="${h.mapsIn}" target="_blank" class="text-teal-700 hover:underline text-[10.5px] font-medium">Maps In</a>` : ''}
                ${h.fotoIn ? `<a href="${h.fotoIn}" target="_blank" class="text-slate-600 hover:underline text-[10.5px]">Foto In</a>` : ''}
                ${h.mapsOut ? `<a href="${h.mapsOut}" target="_blank" class="text-indigo-700 hover:underline text-[10.5px] font-medium">Maps Out</a>` : ''}
              </td>
            </tr>
          `).join('');
                }
            }

            else if (tableKey === 'userDetail') {
                if (meta.sliced.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400">Belum ada riwayat absensi untuk personel ini.</td></tr>`;
                } else {
                    tbody.innerHTML = meta.sliced.map(r => `
