<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Starlite Time Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            margin: 0;
            font-size: 12px;
            /* Ukuran pas untuk 100% Zoom Monitor Desktop */
            -webkit-font-smoothing: antialiased;
        }

        .font-mono-code {
            font-family: 'JetBrains Mono', monospace;
        }

        video {
            transform: scaleX(-1);
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Compact Table Styling (Pas di 100% Chrome) */
        .tiimi-th {
            padding: 7px 10px;
            font-size: 10.5px;
            font-weight: 700;
            color: #475569;
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        .tiimi-filter-cell {
            padding: 4px 8px;
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }

        .tiimi-filter-input {
            width: 100%;
            padding: 3px 6px;
            font-size: 10.5px;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            color: #1e293b;
            outline: none;
        }

        .tiimi-filter-input:focus {
            border-color: #0d9488;
            box-shadow: 0 0 0 1px rgba(13, 148, 136, 0.15);
        }

        .tiimi-td {
            padding: 7px 10px;
            font-size: 11.5px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .tiimi-row:hover {
            background-color: #f8fafc;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">

    <!-- LOADING OVERLAY -->
    <div id="loadingOverlay"
        class="fixed inset-0 bg-slate-900/40 backdrop-blur-[1px] z-50 hidden items-center justify-center">
        <div class="bg-white border border-slate-200 rounded-lg px-4 py-3 shadow-lg flex items-center gap-2.5">
            <div class="w-4 h-4 border-2 border-teal-600 border-t-transparent rounded-full animate-spin"></div>
            <span id="loadingText" class="text-xs font-semibold text-slate-700">Memuat data...</span>
        </div>
    </div>

    <!-- ================= LOGIN VIEW ================= -->
    <div id="loginView" class="min-h-screen flex items-center justify-center p-4 bg-[#1c2434]">
        <div class="w-full max-w-sm bg-white rounded-xl shadow-xl overflow-hidden border border-slate-200">
            <div class="bg-[#243046] px-6 py-4 flex items-center gap-3 border-b border-slate-700/60">
                <div
                    class="w-9 h-9 rounded-lg bg-white/10 p-1 flex items-center justify-center overflow-hidden border border-white/15 shrink-0">
                    <img id="appLogoLogin" src="" alt="Logo" class="w-full h-full object-contain hidden"
                        onload="this.classList.remove('hidden'); this.nextElementSibling.classList.add('hidden');">
                    <span class="text-amber-400 font-extrabold text-sm">SL</span>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-white font-extrabold text-base tracking-tight">starlite</span>
                        <span class="text-slate-400 text-[11px] font-medium">| Time Management</span>
                    </div>
                    <p class="text-[11px] text-slate-300">Sistem Absensi & Monitoring Sales</p>
                </div>
            </div>

            <form onsubmit="handleLogin(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Username</label>
                    <div class="relative">
                        <i class="fa-regular fa-user absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                        <input type="text" id="loginUsername" required placeholder="Masukkan username"
                            class="w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 focus:bg-white focus:outline-none focus:border-teal-600">
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                        <input type="password" id="loginPassword" required placeholder="Masukkan password"
                            class="w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 focus:bg-white focus:outline-none focus:border-teal-600">
                    </div>
                </div>
                <button type="submit"
                    class="w-full py-2 bg-[#0f766e] hover:bg-[#115e59] text-white font-bold text-xs rounded-lg shadow-sm transition flex items-center justify-center gap-1.5">
                    <span>Masuk Aplikasi</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- ================= MAIN APPLICATION SHELL (COMPACT TIIMI) ================= -->
    <div id="appShell" class="hidden min-h-screen flex flex-col">

        <!-- TOP DARK HEADER BAR (COMPACT h-11) -->
        <header
            class="bg-[#1c2434] text-white h-11 px-3 lg:px-5 flex items-center justify-between sticky top-0 z-30 shrink-0 border-b border-slate-800">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <div
                        class="w-6 h-6 rounded bg-amber-400/15 border border-amber-400/30 flex items-center justify-center overflow-hidden p-0.5">
                        <img id="appLogoNav" src="" alt="Logo" class="w-full h-full object-contain hidden"
                            onload="this.classList.remove('hidden'); this.nextElementSibling.classList.add('hidden');">
                        <i class="fa-solid fa-bolt text-amber-400 text-[10px]"></i>
                    </div>
                    <span class="font-extrabold text-sm tracking-tight text-white">starlite</span>
                    <span class="text-slate-600 hidden sm:inline">|</span>
                    <span class="text-[11px] font-semibold text-slate-300 hidden sm:inline">Time Management</span>
                </div>

                <!-- Admin Navigation Pills -->
                <nav id="adminTopNav" class="hidden md:flex items-center gap-1 ml-2">
                    <button onclick="switchAdminTab('tabMonitoring')" id="navBtn_tabMonitoring"
                        class="px-2.5 py-1 rounded text-[11px] font-semibold bg-[#2c374b] text-white transition">
                        Attendance Harian
                    </button>
                    <button onclick="switchAdminTab('tabBelumAbsen')" id="navBtn_tabBelumAbsen"
                        class="px-2.5 py-1 rounded text-[11px] font-semibold text-slate-400 hover:text-white transition flex items-center gap-1">
                        <span>Belum Clock-In</span>
                        <span id="badgeNavBelum"
                            class="px-1.5 py-0.2 bg-rose-500 text-white rounded text-[10px] font-bold">0</span>
                    </button>
                    <button onclick="switchAdminTab('tabSummary')" id="navBtn_tabSummary"
                        class="px-2.5 py-1 rounded text-[11px] font-semibold text-slate-400 hover:text-white transition flex items-center gap-1">
                        <span>Rekap & Akumulasi</span>
                        <span id="badgeNavLate"
                            class="px-1.5 py-0.2 bg-amber-500 text-slate-950 rounded text-[10px] font-bold">0</span>
                    </button>
                    <button onclick="switchAdminTab('tabAllLogs')" id="navBtn_tabAllLogs"
                        class="px-2.5 py-1 rounded text-[11px] font-semibold text-slate-400 hover:text-white transition">
                        Semua Database
                    </button>
                    <button onclick="switchAdminTab('tabUsers')" id="navBtn_tabUsers"
                        class="px-2.5 py-1 rounded text-[11px] font-semibold text-slate-400 hover:text-white transition">
                        Kelola Akun Sales
                    </button>
                    <button onclick="switchAdminTab('tabSettings')" id="navBtn_tabSettings"
                        class="px-2.5 py-1 rounded text-[11px] font-semibold text-slate-400 hover:text-white transition flex items-center gap-1">
                        <i class="fa-regular fa-clock text-[10px] text-amber-400"></i>
                        <span>Jam Kerja</span>
                    </button>
                </nav>
            </div>

            <!-- Right User Info (Tanpa Badge Avatar) & Clock Bar -->
            <div class="flex items-center gap-2.5">
                <div
                    class="hidden sm:flex items-center gap-1.5 bg-[#252f42] px-2.5 py-1 rounded border border-slate-700/70">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span id="liveClock" class="font-mono-code text-[11px] text-slate-200">--:--:-- WIB</span>
                </div>
                <div class="flex items-center gap-2 pl-2 border-l border-slate-700">
                    <div class="text-right leading-tight">
                        <p id="navUserName" class="text-[11px] font-bold text-white"></p>
                        <p id="navUserSub" class="text-[9.5px] text-slate-400"></p>
                    </div>
                    <button onclick="handleLogout()" title="Keluar / Logout"
                        class="p-1.5 rounded bg-slate-800 hover:bg-rose-600 text-slate-300 hover:text-white transition text-xs">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- BODY LAYOUT -->
        <div class="flex-1 flex">

            <!-- LEFT SLIM ICON SIDEBAR (ADMIN ONLY - w-11) -->
            <aside id="adminLeftSidebar"
                class="hidden sm:flex flex-col items-center py-3 w-11 bg-white border-r border-slate-200 shrink-0 justify-between">
                <div class="flex flex-col items-center gap-2">
                    <button onclick="switchAdminTab('tabMonitoring')" id="sideBtn_tabMonitoring"
                        title="Attendance Harian"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-teal-700 bg-teal-50 transition">
                        <i class="fa-solid fa-calendar-check text-xs"></i>
                    </button>
                    <button onclick="switchAdminTab('tabBelumAbsen')" id="sideBtn_tabBelumAbsen" title="Belum Clock-In"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-user-clock text-xs"></i>
                    </button>
                    <button onclick="switchAdminTab('tabSummary')" id="sideBtn_tabSummary"
                        title="Rekap & Akumulasi Per Tanggal"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-chart-column text-xs"></i>
                    </button>
                    <button onclick="switchAdminTab('tabAllLogs')" id="sideBtn_tabAllLogs"
                        title="Semua Database Absensi"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-table-list text-xs"></i>
                    </button>
                    <button onclick="switchAdminTab('tabUsers')" id="sideBtn_tabUsers" title="Kelola Akun Sales"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-users text-xs"></i>
                    </button>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <button onclick="switchAdminTab('tabSettings')" id="sideBtn_tabSettings"
                        title="Pengaturan Jam Kerja"
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-sliders text-xs"></i>
                    </button>
                </div>
            </aside>

            <!-- MAIN WORKSPACE AREA (COMPACT PADDING) -->
            <main class="flex-1 min-w-0 p-3 lg:p-4 max-w-[1600px] mx-auto w-full">

                <!-- ================= SALES VIEW ================= -->
                <div id="salesView" class="hidden max-w-lg mx-auto space-y-3.5">
                    <!-- Sales Profile & Rule Banner (Tanpa Avatar) -->
                    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 id="salesProfileName" class="text-sm font-bold text-slate-900"></h2>
                                    <span id="salesBadgeStatus"
                                        class="px-2 py-0.5 text-[10px] font-bold rounded bg-teal-50 text-teal-700 border border-teal-200"></span>
                                </div>
                                <p class="text-[11px] text-slate-500 mt-0.5">
                                    <span id="salesProfStasiun" class="font-semibold text-slate-700"></span> • <span
                                        id="salesProfProv"></span>
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase">Waktu Server
                                    (WIB)</span>
                                <p id="salesMobileClock" class="text-sm font-mono-code font-bold text-slate-800">
                                    --:--:--</p>
                            </div>
                        </div>

                        <div class="mt-3 pt-2.5 border-t border-slate-100 grid grid-cols-2 gap-2 text-[11px]">
                            <div
                                class="bg-slate-50 rounded-lg p-2 border border-slate-200/70 flex items-center justify-between">
                                <span class="text-slate-500 font-medium">Batas Clock-In:</span>
                                <span id="salesRuleIn" class="font-mono-code font-bold text-slate-800">09:00 WIB</span>
                            </div>
                            <div
                                class="bg-slate-50 rounded-lg p-2 border border-slate-200/70 flex items-center justify-between">
                                <span class="text-slate-500 font-medium">Minimal Clock-Out:</span>
                                <span id="salesRuleOut" class="font-mono-code font-bold text-slate-800">18:00 WIB</span>
                            </div>
                        </div>
                    </div>

                    <!-- Attendance Action Card -->
                    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm space-y-3">
                        <div class="flex items-center justify-between">
                            <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Status Absensi
                                Hari Ini (Reset Harian Otomatis)</h3>
                            <span id="salesTodayDateLabel"
                                class="text-[11px] font-mono-code font-bold text-teal-700 bg-teal-50 px-2 py-0.5 rounded border border-teal-200"></span>
                        </div>

                        <div
                            class="bg-slate-50 rounded-lg p-3 border border-slate-200 flex items-center justify-between">
                            <div class="text-left">
                                <span class="text-[10px] font-semibold text-slate-400 block">CLOCK-IN</span>
                                <span id="statusBoxIn"
                                    class="font-mono-code text-sm font-bold text-slate-800 mt-0.5 block">Belum
                                    Absen</span>
                                <span id="badgeBoxIn"
                                    class="text-[10px] font-bold px-1.5 py-0.5 rounded hidden mt-1 inline-block"></span>
                            </div>

                            <div class="flex-1 px-3 flex flex-col items-center">
                                <span id="salesWorkDuration"
                                    class="text-[10px] font-semibold text-slate-500 mb-1">-</span>
                                <div class="w-full flex items-center">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
                                    <div class="flex-1 h-[1.5px] bg-slate-300"></div>
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
                                </div>
                            </div>

                            <div class="text-right">
                                <span class="text-[10px] font-semibold text-slate-400 block">CLOCK-OUT</span>
                                <span id="statusBoxOut"
                                    class="font-mono-code text-sm font-bold text-slate-800 mt-0.5 block">Belum
                                    Absen</span>
                                <span id="badgeBoxOut"
                                    class="text-[10px] font-bold px-1.5 py-0.5 rounded hidden mt-1 inline-block"></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2.5">
                            <button id="btnClockIn" onclick="openAttendanceModal('IN')"
                                class="py-2.5 px-3 bg-[#0f766e] hover:bg-[#115e59] disabled:bg-slate-100 disabled:text-slate-400 border border-transparent text-white font-bold text-xs rounded-lg shadow-sm transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-camera"></i>
                                <span>CLOCK IN</span>
                            </button>

                            <button id="btnClockOut" onclick="openAttendanceModal('OUT')"
                                class="py-2.5 px-3 bg-[#1c2434] hover:bg-slate-800 disabled:bg-slate-100 disabled:text-slate-400 border border-transparent text-white font-bold text-xs rounded-lg shadow-sm transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>CLOCK OUT</span>
                            </button>
                        </div>
                        <p id="salesLockNotice" class="text-[10.5px] text-center text-slate-500"></p>
                    </div>

                    <!-- Sales Personal History Table -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="px-4 py-2.5 border-b border-slate-200 flex items-center justify-between">
                            <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-600">Riwayat Absensi
                                Anda</h4>
                            <span id="salesHistCountLabel" class="text-[11px] text-slate-400"></span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr>
                                        <th class="tiimi-th">Tanggal</th>
                                        <th class="tiimi-th">Clock-in & Out</th>
                                        <th class="tiimi-th">Status In</th>
                                        <th class="tiimi-th">Status Out</th>
                                        <th class="tiimi-th">Maps & Foto</th>
                                    </tr>
                                    <tr>
                                        <th class="tiimi-filter-cell"><input type="text"
                                                oninput="updateTableFilter('salesHistory', 'tanggal', this.value)"
                                                placeholder="Tanggal..." class="tiimi-filter-input"></th>
                                        <th class="tiimi-filter-cell"><input type="text"
                                                oninput="updateTableFilter('salesHistory', 'jamIn', this.value)"
                                                placeholder="Jam..." class="tiimi-filter-input"></th>
                                        <th class="tiimi-filter-cell">
                                            <select onchange="updateTableFilter('salesHistory', 'statusIn', this.value)"
                                                class="tiimi-filter-input">
                                                <option value="">Semua</option>
                                                <option value="On Time">On Time</option>
                                                <option value="Late">Late</option>
                                            </select>
                                        </th>
                                        <th class="tiimi-filter-cell">
                                            <select
                                                onchange="updateTableFilter('salesHistory', 'statusOut', this.value)"
                                                class="tiimi-filter-input">
                                                <option value="">Semua</option>
                                                <option value="Completed">Completed</option>
                                            </select>
                                        </th>
                                        <th class="tiimi-filter-cell"></th>
                                    </tr>
                                </thead>
                                <tbody id="tbody_salesHistory"></tbody>
                            </table>
                        </div>
                        <div id="pager_salesHistory"
                            class="px-4 py-2 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-[11px]">
                        </div>
                    </div>
                </div>

                <!-- ================= ADMIN VIEW (COMPACT TIIMI DASHBOARD) ================= -->
                <div id="adminView" class="hidden space-y-3">

                    <!-- Mobile Tab Switcher -->
                    <div class="flex md:hidden gap-1 overflow-x-auto pb-1">
                        <button onclick="switchAdminTab('tabMonitoring')"
                            class="px-2.5 py-1 rounded text-[11px] font-bold bg-white border border-slate-200 text-slate-700 shrink-0">Harian</button>
                        <button onclick="switchAdminTab('tabBelumAbsen')"
                            class="px-2.5 py-1 rounded text-[11px] font-bold bg-white border border-slate-200 text-rose-600 shrink-0">Belum
                            Absen</button>
                        <button onclick="switchAdminTab('tabSummary')"
                            class="px-2.5 py-1 rounded text-[11px] font-bold bg-white border border-slate-200 text-amber-600 shrink-0">Rekap
                            Tanggal</button>
                        <button onclick="switchAdminTab('tabAllLogs')"
                            class="px-2.5 py-1 rounded text-[11px] font-bold bg-white border border-slate-200 text-slate-700 shrink-0">Semua
                            Data</button>
                        <button onclick="switchAdminTab('tabUsers')"
                            class="px-2.5 py-1 rounded text-[11px] font-bold bg-white border border-slate-200 text-slate-700 shrink-0">Kelola
                            Akun</button>
                        <button onclick="switchAdminTab('tabSettings')"
                            class="px-2.5 py-1 rounded text-[11px] font-bold bg-white border border-slate-200 text-teal-700 shrink-0">Jam
                            Kerja</button>
                    </div>

                    <!-- TIIMI TOP TITLE & DATE STEPPER BAR -->
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-2.5">
                            <h1 id="adminPageTitle" class="text-base font-extrabold text-slate-900 tracking-tight">
                                Attendance Harian</h1>

                            <div
                                class="flex items-center bg-white border border-slate-200 rounded-lg shadow-sm px-1 py-0.5">
                                <button onclick="stepAdminDate(-1)"
                                    class="w-6 h-6 flex items-center justify-center text-slate-500 hover:text-slate-900 rounded hover:bg-slate-100">
                                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                                </button>
                                <input type="date" id="adminDateFilter" onchange="onHeaderDateChange()"
                                    class="px-1.5 py-0.5 text-[11.5px] font-bold text-slate-800 bg-transparent border-0 focus:outline-none cursor-pointer">
                                <button onclick="stepAdminDate(1)"
                                    class="w-6 h-6 flex items-center justify-center text-slate-500 hover:text-slate-900 rounded hover:bg-slate-100">
                                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Right Action Buttons -->
                        <div class="flex items-center gap-2">
                            <button onclick="switchAdminTab('tabSettings')"
                                class="px-2.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-lg text-[11px] font-semibold shadow-sm transition flex items-center gap-1.5">
                                <i class="fa-regular fa-clock text-teal-600"></i>
                                <span>In: <strong id="headerBadgeMaxIn">09:00</strong> | Out: <strong
                                        id="headerBadgeMinOut">18:00</strong></span>
                            </button>
                            <button onclick="loadAdminData()"
                                class="px-2.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-lg text-[11px] font-semibold shadow-sm transition flex items-center gap-1">
                                <i class="fa-solid fa-rotate text-slate-500"></i>
                                <span>Refresh</span>
                            </button>
                            <button onclick="switchAdminTab('tabUsers')"
                                class="px-2.5 py-1.5 bg-[#0f766e] hover:bg-[#115e59] text-white rounded-lg text-[11px] font-semibold shadow-sm transition flex items-center gap-1">
                                <i class="fa-solid fa-user-plus"></i>
                                <span>Tambah Sales</span>
                            </button>
                        </div>
                    </div>

                    <!-- TIIMI COMPACT GROUPED SUMMARY CARDS (Harian Tanggal Terpilih) -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3">
                        <!-- Present Summary -->
                        <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 px-3.5 py-2.5 shadow-sm">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[11px] font-bold text-slate-700 flex items-center gap-1.5">
                                    <i class="fa-solid fa-clipboard-check text-teal-600"></i> Present Summary (<span
                                        class="lblSelectedDate"></span>)
                                </span>
                            </div>
                            <div class="grid grid-cols-3 divide-x divide-slate-100">
                                <div class="pr-3">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">On Time</p>
                                    <p id="kpiOnTime" class="text-lg font-extrabold text-teal-600 leading-tight">0</p>
                                    <p class="text-[10px] text-slate-400">≤ <span id="subLabelMaxIn">09:00</span></p>
                                </div>
                                <div class="px-3">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">Late Clock-In</p>
                                    <p id="kpiLate" class="text-lg font-extrabold text-amber-600 leading-tight">0</p>
                                    <p class="text-[10px] text-slate-400">> <span id="subLabelLateIn">09:00</span></p>
                                </div>
                                <div class="pl-3">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">Lengkap (In & Out)</p>
                                    <p id="kpiClockedOut" class="text-lg font-extrabold text-slate-900 leading-tight">0
                                    </p>
                                    <p class="text-[10px] text-slate-400">Sudah Clock-Out</p>
                                </div>
                            </div>
                        </div>

                        <!-- Not Present Summary -->
                        <div class="lg:col-span-4 bg-white rounded-xl border border-slate-200 px-3.5 py-2.5 shadow-sm">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[11px] font-bold text-slate-700 flex items-center gap-1.5">
                                    <i class="fa-solid fa-user-xmark text-rose-600"></i> Not Present / Incomplete
                                </span>
                                <button onclick="switchAdminTab('tabBelumAbsen')"
                                    class="text-[10px] text-teal-600 font-bold hover:underline">Cek Daftar</button>
                            </div>
                            <div class="grid grid-cols-2 divide-x divide-slate-100">
                                <div class="pr-3">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">Belum Clock-In</p>
                                    <p id="kpiBelumAbsen" class="text-lg font-extrabold text-rose-600 leading-tight">0
                                    </p>
                                    <p class="text-[10px] text-rose-500">Belum absen masuk</p>
                                </div>
                                <div class="pl-3">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">Belum Clock-Out</p>
                                    <p id="kpiBelumOut" class="text-lg font-extrabold text-indigo-600 leading-tight">0
                                    </p>
                                    <p class="text-[10px] text-slate-400">Sudah In, Belum Out</p>
                                </div>
                            </div>
                        </div>

                        <!-- Workforce Ratio -->
                        <div class="lg:col-span-3 bg-white rounded-xl border border-slate-200 px-3.5 py-2.5 shadow-sm">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[11px] font-bold text-slate-700 flex items-center gap-1.5">
                                    <i class="fa-solid fa-chart-pie text-indigo-600"></i> Rasio Kehadiran Aktif
                                </span>
                            </div>
                            <div class="grid grid-cols-2 divide-x divide-slate-100">
                                <div class="pr-2">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">Sales Aktif</p>
                                    <p id="kpiTotalSales" class="text-lg font-extrabold text-slate-900 leading-tight">0
                                    </p>
                                    <p class="text-[10px] text-slate-400">Terdaftar</p>
                                </div>
                                <div class="pl-2">
                                    <p class="text-[10px] font-semibold text-slate-400 uppercase">Rasio Hadir</p>
                                    <p id="kpiAttendanceRate"
                                        class="text-lg font-extrabold text-teal-600 leading-tight">0%</p>
                                    <p class="text-[10px] text-slate-400">Dari total sales</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ================= TAB 1: MONITORING HARIAN ================= -->
                    <div id="tabMonitoring"
                        class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div
                            class="px-4 py-2.5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-700">Daftar Absensi
                                    Masuk & Pulang (<span class="lblSelectedDate"></span>)</h3>
                                <span class="text-[10.5px] text-slate-400">• 30 data/halaman</span>
                            </div>
                            <button onclick="resetTableFilters('todayLogs')"
                                class="text-[11px] text-teal-600 hover:underline font-semibold">
                                <i class="fa-solid fa-filter-circle-xmark mr-1"></i>Reset Filter
                            </button>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
