                <td class="tiimi-td text-center">
                  <button onclick="openUserDetailModal('${l.username}')" class="px-2 py-1 bg-slate-100 hover:bg-teal-600 text-slate-700 hover:text-white rounded text-[10.5px] font-semibold border border-slate-200 transition">
                    <i class="fa-solid fa-eye mr-0.5"></i> Detail
                  </button>
                </td>
              </tr>
            `;
