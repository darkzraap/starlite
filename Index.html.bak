                                        <th class="tiimi-filter-cell"><input type="text" id="flt_summary_stasiun"
                                                oninput="updateTableFilter('summary', 'stasiun', this.value)"
                                                placeholder="Stasiun..." class="tiimi-filter-input"></th>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_summary_totalBelumIn"
                                                oninput="updateTableFilter('summary', 'totalBelumIn', this.value)"
                                                placeholder="Jml..." class="tiimi-filter-input text-center"></th>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_summary_totalHadir"
                                                oninput="updateTableFilter('summary', 'totalHadir', this.value)"
                                                placeholder="Jml..." class="tiimi-filter-input text-center"></th>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_summary_totalOnTime"
