                                                <option value="Belum Clock-Out">Belum Out</option>
                                            </select>
                                        </th>
                                        <th class="tiimi-filter-cell"></th>
                                        <th class="tiimi-filter-cell"><input type="text" id="flt_todayLogs_koordinatIn"
